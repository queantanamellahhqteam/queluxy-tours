* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
}

body {
  font-family: Arial, Helvetica, sans-serif;
  background: #f7f5ef;
  color: #171717;
  line-height: 1.6;
}

a {
  text-decoration: none;
  color: inherit;
}


/* =========================
   NAVIGATION
========================= */

header {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  padding: 25px 7%;
  display: flex;
  align-items: center;
  justify-content: space-between;
  z-index: 10;
  color: white;
}

.logo {
  font-size: 24px;
  font-weight: 800;
  letter-spacing: -1px;
}

.logo span {
  color: #d6ad60;
}

nav {
  display: flex;
  gap: 30px;
}

nav a {
  font-size: 14px;
  transition: 0.3s;
}

nav a:hover {
  color: #d6ad60;
}

.whatsapp-small {
  border: 1px solid rgba(255,255,255,0.5);
  padding: 10px 18px;
  border-radius: 30px;
  font-size: 13px;
}


/* =========================
   HERO
========================= */

.hero {
  min-height: 100vh;
  display: flex;
  align-items: center;
  position: relative;

  background:
    linear-gradient(
      rgba(0,0,0,0.55),
      rgba(0,0,0,0.55)
    ),
    url("https://images.unsplash.com/photo-1516426122078-c23e76319801?auto=format&fit=crop&w=2000&q=85")
    center/cover no-repeat;

  color: white;
}

.hero-content {
  max-width: 800px;
  margin-left: 7%;
  padding-top: 80px;
}

.small-title {
  font-size: 12px;
  letter-spacing: 4px;
  font-weight: bold;
  margin-bottom: 20px;
  color: #d6ad60;
}

.small-title.dark {
  color: #a77b32;
}

.hero h1 {
  font-size: clamp(48px, 7vw, 88px);
  line-height: 1.02;
  letter-spacing: -3px;
  margin-bottom: 25px;
}

.hero h1 span,
h2 span {
  color: #d6ad60;
  font-style: italic;
}

.hero-content > p:not(.small-title) {
  max-width: 600px;
  color: rgba(255,255,255,0.85);
  font-size: 18px;
}

.buttons {
  display: flex;
  gap: 15px;
  margin-top: 35px;
}

.btn {
  display: inline-block;
  padding: 14px 25px;
  background: #d6ad60;
  color: #111;
  border-radius: 4px;
  font-weight: bold;
  transition: 0.3s;
}

.btn:hover {
  transform: translateY(-3px);
}

.btn.outline {
  background: transparent;
  color: white;
  border: 1px solid rgba(255,255,255,0.6);
}


/* =========================
   INTRO
========================= */

.intro {
  padding: 110px 7%;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 80px;
  align-items: center;
}

.intro h2,
.section-title h2,
.contact h2 {
  font-size: clamp(38px, 5vw, 62px);
  line-height: 1.05;
  letter-spacing: -2px;
}

.intro > p {
  font-size: 18px;
  color: #666;
}


/* =========================
   SAFARI
========================= */

.safari {
  padding: 100px 7%;
  background: #ebe7dc;
}

.section-title {
  display: flex;
  justify-content: space-between;
  align-items: end;
  gap: 40px;
  margin-bottom: 50px;
}

.section-title > p {
  max-width: 420px;
  color: #666;
}

.cards {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 25px;
}

.card {
  min-height: 480px;
  position: relative;
  overflow: hidden;
  display: flex;
  align-items: end;
  color: white;
  background-size: cover;
  background-position: center;
  transition: 0.4s;
}

.card:hover {
  transform: translateY(-8px);
}

.safari-card {
  background-image:
    linear-gradient(transparent, rgba(0,0,0,0.85)),
    url("https://images.unsplash.com/photo-1516426122078-c23e76319801?auto=format&fit=crop&w=1000&q=80");
}

.zanzibar-card {
  background-image:
    linear-gradient(transparent, rgba(0,0,0,0.85)),
    url("https://images.unsplash.com/photo-1548013146-72479768bada?auto=format&fit=crop&w=1000&q=80");
}

.mountain-card {
  background-image:
    linear-gradient(transparent, rgba(0,0,0,0.85)),
    url("https://images.unsplash.com/photo-1609198092458-38a293c7ac4b?auto=format&fit=crop&w=1000&q=80");
}

.card-content {
  padding: 30px;
}

.card-content small {
  color: #d6ad60;
  font-weight: bold;
}

.card h3 {
  font-size: 28px;
  margin: 8px 0;
}

.card p {
  color: rgba(255,255,255,0.8);
  margin-bottom: 20px;
}

.card a {
  color: #d6ad60;
  font-weight: bold;
}


/* =========================
   WHY QUELUXY
========================= */

.why {
  background: #151713;
  color: white;
  padding: 110px 7%;
  display: grid;
  grid-template-columns: 1fr 1.5fr;
  gap: 80px;
}

.why h2 {
  font-size: clamp(42px, 5vw, 65px);
  line-height: 1;
}

.features {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 30px;
}

.features strong {
  color: #d6ad60;
  font-size: 30px;
}

.features h3 {
  margin: 15px 0 10px;
}

.features p {
  color: #aaa;
  font-size: 14px;
}


/* =========================
   CONTACT
========================= */

.contact {
  padding: 110px 7%;
  display: grid;
  grid-template-columns: 1.2fr 1fr;
  gap: 80px;
  align-items: center;
}

.contact > div:first-child > p:last-child {
  margin-top: 25px;
  max-width: 600px;
  color: #666;
}

.contact-box {
  background: #171914;
  padding: 35px;
  border-radius: 5px;
}

.contact-box a {
  display: block;
  padding: 20px 0;
  border-bottom: 1px solid #333;
  color: white;
}

.contact-box a:last-child {
  border-bottom: none;
}

.contact-box small {
  display: block;
  color: #d6ad60;
  letter-spacing: 2px;
  margin-bottom: 5px;
}

.contact-box strong {
  font-size: 17px;
}


/* =========================
   FOOTER
========================= */

footer {
  padding: 35px 7%;
  background: #0e0f0d;
  color: #aaa;
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 20px;
}

footer .logo {
  color: white;
}


/* =========================
   FLOATING WHATSAPP
========================= */

.whatsapp {
  position: fixed;
  right: 22px;
  bottom: 22px;
  background: #25D366;
  color: white;
  padding: 13px 20px;
  border-radius: 50px;
  font-weight: bold;
  box-shadow: 0 10px 30px rgba(0,0,0,0.25);
  z-index: 50;
}


/* =========================
   MOBILE
========================= */

@media (max-width: 800px) {

  header {
    padding: 20px 5%;
  }

  nav {
    display: none;
  }

  .hero-content {
    margin-left: 5%;
    margin-right: 5%;
  }

  .hero h1 {
    font-size: 50px;
  }

  .buttons {
    flex-direction: column;
    max-width: 250px;
  }

  .intro,
  .contact,
  .why {
    grid-template-columns: 1fr;
    gap: 45px;
    padding: 80px 5%;
  }

  .safari {
    padding: 80px 5%;
  }

  .section-title {
    display: block;
  }

  .section-title > p {
    margin-top: 20px;
  }

  .cards {
    grid-template-columns: 1fr;
  }

  .card {
    min-height: 420px;
  }

  .features {
    grid-template-columns: 1fr;
  }

  footer {
    flex-direction: column;
    text-align: center;
  }

}

@media (max-width: 450px) {

  .hero h1 {
    font-size: 42px;
  }

  .hero-content > p:not(.small-title) {
    font-size: 16px;
  }

  .whatsapp-small {
    display: none;
  }

}
